{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".build-tmp/types/**/*.ts",
    ".build-tmp/dev/types/**/*.ts",
    ".build-tmp2/types/**/*.ts",
    ".build-tmp2/dev/types/**/*.ts",
    ".build-tmp3/types/**/*.ts",
    ".build-tmp3/dev/types/**/*.ts",
    ".build-tmp4/types/**/*.ts",
    ".build-tmp4/dev/types/**/*.ts",
    ".build-verify/types/**/*.ts",
    ".build-verify/dev/types/**/*.ts",
    ".build-v1/types/**/*.ts",
    ".build-v1/dev/types/**/*.ts",
    ".build-v2/types/**/*.ts",
    ".build-v2/dev/types/**/*.ts",
    ".build-v5/types/**/*.ts",
    ".build-v5/dev/types/**/*.ts",
    ".build-v6/types/**/*.ts",
    ".build-v6/dev/types/**/*.ts",
    ".build-v7/types/**/*.ts",
    ".build-v7/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "项目文档"
  ]
}
